## Random eligible event id for a node ("" only if nothing at all is eligible).
## Region events weigh double over "any"; unlocked memory fragments weigh triple.
static func pick(region: String, stage: int, day: int, exclude: Array) -> String:
	var bag := _eligible(region, stage, day, exclude)
	if bag.is_empty():
		bag = _eligible(region, stage, day, [])
	if bag.is_empty():
		return ""
	return str(bag[randi() % bag.size()])


static func get_event(id: String) -> Dictionary:
	var e: Dictionary = EVENTS.get(id, {})
	return e.duplicate(true)


static func _eligible(region: String, stage: int, day: int, exclude: Array) -> Array:
	var bag: Array = []
	for id in EVENTS:
		if exclude.has(id):
			continue
		var e: Dictionary = EVENTS[id]
		var r: String = e.get("region", "any")
		if r != region and r != "any":
			continue
		var min_stage: int = int(e.get("min_stage", 0))
		var min_day: int = int(e.get("min_day", 0))
		if stage < min_stage or day < min_day:
			continue
		var weight := 1
		if r == region:
			weight = 2
			if min_stage > 0 or min_day > 0:
				weight = 3
		for _i in weight:
			bag.append(id)
	return bag
